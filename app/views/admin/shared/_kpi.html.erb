<%# locals: (label:, value:, hint: nil, tone: nil) -%>
<%# Un número destacado de la página (KPI). Va dentro de <dl class="admin-kpis">; para cifras chicas dentro de una tarjeta está .admin-stat-tile; `tone` puede ser ok, bad o accent. -%>
<div class="<%= class_names("admin-kpi", "admin-kpi--#{tone}" => tone) %>">
  <dt class="admin-kpi__label"><%= label %></dt>
  <dd class="admin-kpi__value"><%= value %></dd>
  <% if hint %><dd class="admin-kpi__hint"><%= hint %></dd><% end %>
</div>
