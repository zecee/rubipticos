<%# locals: (cryptic:, stats:) -%>
<article class="admin-card" aria-labelledby="<%= dom_id(cryptic, :title) %>">
  <header class="admin-card__header">
    <h2 id="<%= dom_id(cryptic, :title) %>">Críptico <%= cryptic.external_id %></h2>
    <%= render "admin/cryptics/status", cryptic: cryptic %>
  </header>

  <ul class="admin-tags" aria-label="Clasificación">
    <li class="admin-tag admin-tag--type">
      <span class="visually-hidden">Tipo:</span> <%= cryptic.puzzle_type_label %>
    </li>
    <li class="admin-tag admin-tag--<%= cryptic.difficulty %>">
      <span class="visually-hidden">Dificultad:</span>
      <span class="admin-tag__level" aria-hidden="true"><% Cryptic::DIFFICULTIES.each_with_index do |level, i| %><span class="<%= "is-on" if i <= Cryptic::DIFFICULTIES.index(cryptic.difficulty) %>"></span><% end %></span>
      <%= cryptic.difficulty_label %>
    </li>
  </ul>

  <section class="admin-cryptic-clue" aria-labelledby="<%= dom_id(cryptic, :clue) %>">
    <h3 id="<%= dom_id(cryptic, :clue) %>" class="admin-section-title">Enunciado</h3>
    <p class="admin-clue"><%= highlighted_clue(cryptic) %> <span class="admin-muted"><%= cryptic.enumeration %></span></p>

    <dl class="admin-parts">
      <% Admin::CrypticsHelper::PART_ROLES.each do |role, config| %>
        <div class="admin-parts__row">
          <dt><span class="admin-part admin-part--<%= role %> admin-part--key" aria-hidden="true"></span><%= part_label(role) %></dt>
          <dd>
            <% parts = Array(cryptic.public_send(config[:field])) %>
            <% if parts.any? %>
              <%= safe_join(parts.map { |part| tag.span(part, class: "admin-chip admin-chip--#{role}") }, " ") %>
            <% else %>
              <span class="admin-muted">—</span>
            <% end %>
          </dd>
        </div>
      <% end %>
    </dl>
  </section>

  <section aria-labelledby="<%= dom_id(cryptic, :answer) %>">
    <h3 id="<%= dom_id(cryptic, :answer) %>" class="admin-section-title">Respuesta</h3>
    <p class="admin-answer">
      <span class="visually-hidden"><%= cryptic.answer %></span>
      <% answer_words(cryptic).each do |letters| %>
        <span class="admin-answer__word" aria-hidden="true"><% letters.each do |letter| %><span class="admin-answer__cell"><%= letter %></span><% end %></span>
      <% end %>
    </p>
  </section>

  <% if cryptic.hint.present? || cryptic.explanation.present? %>
    <div class="admin-notes">
      <% if cryptic.hint.present? %>
        <section class="admin-note admin-note--hint">
          <h3 class="admin-section-title">Ayuda</h3>
          <p><%= cryptic.hint %></p>
        </section>
      <% end %>
      <% if cryptic.explanation.present? %>
        <section class="admin-note admin-note--explanation">
          <h3 class="admin-section-title">Explicación</h3>
          <p><%= cryptic.explanation %></p>
        </section>
      <% end %>
    </div>
  <% end %>

  <section aria-labelledby="<%= dom_id(cryptic, :meta) %>">
    <h3 id="<%= dom_id(cryptic, :meta) %>" class="admin-section-title">Procedencia</h3>
    <dl class="admin-meta">
      <div class="admin-meta__row"><dt>Autor</dt><dd><%= cryptic.author.presence || "Sin autor" %></dd></div>
      <div class="admin-meta__row"><dt>Origen</dt><dd><span class="admin-chip admin-chip--source"><%= cryptic.source %></span></dd></div>
    </dl>
  </section>

  <section class="admin-stats" aria-labelledby="<%= dom_id(cryptic, :stats) %>">
    <h3 id="<%= dom_id(cryptic, :stats) %>" class="admin-section-title">Estadísticas</h3>
    <% if stats.played? %>
      <dl class="admin-stat-tiles">
        <div class="admin-stat-tile"><dt>Veces jugado</dt><dd><%= stats.played_count %></dd></div>
        <div class="admin-stat-tile">
          <dt>Resuelto</dt>
          <dd><%= stats.solved_percentage %> % <small>(<%= stats.solved_count %> de <%= stats.played_count %>)</small></dd>
        </div>
        <div class="admin-stat-tile"><dt>Tiempo promedio</dt><dd><%= solve_time(stats.average_solve_seconds) %></dd></div>
      </dl>
    <% else %>
      <p class="admin-stats__empty">Todavía nadie lo jugó.</p>
    <% end %>
  </section>

  <%= form_with model: cryptic, url: admin_cryptic_path(cryptic), method: :patch, class: "admin-activation" do |form| %>
    <%= form.hidden_field :active, value: !cryptic.active? %>
    <button type="submit" class="admin-switch" role="switch" aria-checked="<%= cryptic.active? %>"
            aria-labelledby="<%= dom_id(cryptic, :activation_label) %>"
            aria-describedby="<%= dom_id(cryptic, :activation_hint) %>">
      <span class="admin-switch__track" aria-hidden="true">
        <span class="admin-switch__text admin-switch__text--on">ON</span>
        <span class="admin-switch__text admin-switch__text--off">OFF</span>
        <span class="admin-switch__thumb"></span>
      </span>
    </button>
    <span id="<%= dom_id(cryptic, :activation_label) %>" class="admin-activation__label">Activo en el juego</span>
    <p id="<%= dom_id(cryptic, :activation_hint) %>" class="admin-field__hint">
      <%= cryptic.active? ? "Se asigna en partidas nuevas. Apagalo para dejar de asignarlo." : "No se asigna en partidas nuevas. Encendelo para volver a asignarlo." %>
    </p>
  <% end %>

  <p><%= link_to "← Volver a Crípticos", admin_cryptics_path, data: { turbo_frame: "_top" } %></p>
</article>
