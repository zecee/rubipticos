<%= render "admin/shared/page_header", title: "Crípticos",
           description: "Catálogo sincronizado desde la fuente. Para sumar o cambiar crípticos, sincronizá." %>

<%= form_with url: admin_cryptics_path, method: :get, class: "admin-filters", role: "search",
              aria: { label: "Filtrar crípticos" } do |form| %>
  <div class="admin-field">
    <%= form.label :difficulty, "Dificultad" %>
    <%= form.select :difficulty, cryptic_filter_options(Cryptic::DIFFICULTY_LABELS, @filters[:difficulty]),
                    include_blank: "Todas" %>
  </div>
  <div class="admin-field">
    <%= form.label :puzzle_type, "Tipo" %>
    <%= form.select :puzzle_type, cryptic_filter_options(Cryptic::PUZZLE_TYPE_LABELS, @filters[:puzzle_type]),
                    include_blank: "Todos" %>
  </div>
  <div class="admin-field">
    <%= form.label :status, "Estado" %>
    <%= form.select :status, cryptic_filter_options(Cryptic::STATUS_LABELS, @filters[:status]),
                    include_blank: "Todos" %>
  </div>
  <div class="admin-filters__actions">
    <%= form.button "Filtrar", name: nil, class: "admin-button" %>
    <% if @filters.compact_blank.any? %>
      <%= link_to "Limpiar", admin_cryptics_path %>
    <% end %>
  </div>
<% end %>

<div class="admin-split">
  <div class="admin-split__list">
    <% if @cryptics.any? %>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th scope="col">Id</th>
              <th scope="col">Enunciado</th>
              <th scope="col">Tipo</th>
              <th scope="col">Dificultad</th>
              <th scope="col">Estado</th>
            </tr>
          </thead>
          <tbody>
            <% @cryptics.each do |cryptic| %>
              <tr id="<%= dom_id(cryptic) %>">
                <td><%= link_to cryptic.external_id, admin_cryptic_path(cryptic), data: { turbo_frame: "cryptic_detail" } %></td>
                <td><%= cryptic.clue %> <span class="admin-muted"><%= cryptic.enumeration %></span></td>
                <td><%= cryptic.puzzle_type_label %></td>
                <td><%= cryptic.difficulty_label %></td>
                <td><%= render "admin/cryptics/status", cryptic: cryptic %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <%= will_paginate @cryptics, class: "admin-pagination", inner_window: 2, renderer: Admin::PaginationRenderer %>
    <% elsif @filters.compact_blank.any? %>
      <p class="admin-empty">Ningún críptico coincide con los filtros. <%= link_to "Ver todos", admin_cryptics_path %>.</p>
    <% else %>
      <p class="admin-empty">Todavía no hay crípticos. Corré <code>bin/rails db:seed</code> o sincronizá el catálogo.</p>
    <% end %>

    <%= render "admin/shared/pending", items: [
      "Filtros por origen.",
      "Activar y desactivar cada críptico."
    ] %>
  </div>

  <%= turbo_frame_tag "cryptic_detail", class: "admin-split__detail", data: { turbo_action: "advance" } do %>
    <p class="admin-empty">Elegí un críptico de la lista para ver su detalle.</p>
  <% end %>
</div>
