<% content_for :title, "Iniciar sesión" %>

<%= form_with url: session_path, class: "admin-auth__form" do |form| %>
  <div class="admin-auth__field">
    <%= form.label :email_address, "Email" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
  </div>

  <div class="admin-auth__field">
    <%= form.label :password, "Contraseña" %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
  </div>

  <%= form.submit "Ingresar", class: "admin-auth__submit" %>
<% end %>

<footer class="admin-auth__footer">
  <span>No hay registro público.</span>
  <%= link_to "¿Olvidaste tu contraseña?", new_password_path %>
</footer>
